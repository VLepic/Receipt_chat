# ReceiptChat application container in Unraid Docker UI.
# Map container port 8080 to a host port, e.g. 5173, in the Docker template.
# Mount a persistent host directory at DOCUMENT_STORAGE_DIR and /root/.EasyOCR.
APP_NAME=ReceiptChat
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+asyncpg://receiptchat:replace-password@POSTGRES_HOST:5432/receiptchat
COOKIE_SECURE=true
DOCUMENT_STORAGE_DIR=/app/storage/documents
DOCUMENT_MAX_UPLOAD_BYTES=10485760
