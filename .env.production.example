# Production Compose deployment. Configure model servers, models and OCR in the application.
APP_NAME=ReceiptChat
APP_PORT=5173
SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-with-a-strong-database-password
SP2_DATA_DIR=/opt/stacks/sp2/data
COOKIE_SECURE=true
DOCUMENT_STORAGE_DIR=/app/storage/documents
DOCUMENT_MAX_UPLOAD_BYTES=10485760
